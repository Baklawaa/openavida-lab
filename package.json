{
  "name": "openavida-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAvida Lab — browser artificial-evolution laboratory",
  "scripts": {
    "dev": "vite --port 5174 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "launch": "node tools/launch.mjs"
  },
  "devDependencies": {
    "playwright": "1.53.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
