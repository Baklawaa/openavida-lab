{
  "name": "openavida-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAvida Lab — browser artificial-evolution laboratory",
  "scripts": {
    "dev": "vite --port 5174 --strictPort --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort --host 127.0.0.1",
    "test": "vitest run",
    "baseline": "OPENAVIDA_UPDATE_BASELINE=1 vitest run tests/engine.test.ts",
    "docs": "OPENAVIDA_UPDATE_DOC=1 vitest run tests/modelDoc.test.ts",
    "perf": "vite-node tools/perf.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "gates": "node tools/gates.mjs",
    "sim": "node tools/build-cli.mjs && node dist-cli/openavida.mjs",
    "reproduce": "node tools/verify-reproduce.mjs",
    "launch": "node tools/launch.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "happy-dom": "^20.14.5",
    "playwright": "1.53.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
